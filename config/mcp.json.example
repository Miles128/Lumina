{
  "_comment": "Standard MCP only (stdio / SSE / streamable_http). No platform-specific Lumina connectors — see docs/PRD.md.",
  "servers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/you"
      ],
      "enabled": true,
      "transport": "stdio",
      "timeout": 120
    }
  }
}
